{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AdventureWorks2022;Trusted_Connection=True;TrustServerCertificate=True"

  },
  "PublicBaseUrl": "http://localhost:5100",
  "PdfCallbackUrl": "http://localhost:5053/api/Orders/GeneratePdf",
  "EmailUrl": "http://127.0.0.1:8001/",
  "MessageUrl": "http://localhost:3000/",
  "DefaultDelayMinutes": 5,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Hangfire": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }

}
